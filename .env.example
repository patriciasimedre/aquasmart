# ============================================================
#  AquaSmart — exemplu de configurare. Copiaza in .env:
#    cp .env.example .env
#  apoi completeaza valorile reale. .env NU se urca in git.
# ============================================================

# ---------- Aplicatie ----------
APP_NAME=AquaSmart
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# ---------- Baza de date (Azure Database for MySQL Flexible Server) ----------
DB_HOST=aquasmart-db.mysql.database.azure.com
DB_PORT=3306
DB_NAME=aquasmart
DB_USER=aquaadmin
DB_PASSWORD=parola_ta_aici
# Compat: daca .env-ul tau vechi foloseste DB_PASS, codul il citeste ca rezerva
# pentru DB_PASSWORD — nu trebuie sa-l stergi imediat.

# Optional: certificatul DigiCert pentru verificare TLS stricta la Azure.
# Lasa GOL => conexiune TLS fara verificarea CA (Azure accepta si asa).
# Pentru verificare completa, descarca certificatul si pune calea absoluta aici:
#   https://dl.cacerts.digicert.com/DigiCertGlobalRootCA.crt.pem
DB_SSL_CA=

# ---------- API ESP32 (Bearer token pentru autentificarea placii) ----------
ESP32_API_KEY=cheia_ta_secreta_aici

# ---------- OpenWeatherMap (prognoza meteo) ----------
OPENWEATHER_API_KEY=cheia_openweathermap
OPENWEATHER_CITY=Timisoara,RO

# ---------- Claude API (raport AI — optional) ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
